# Copiar a .env.local y completar. Los mismos nombres se usan en Vercel.

# Local: el Postgres de Homebrew. En Vercel lo inyecta la integración de Neon.
POSTGRES_URL=postgres://TU_USUARIO@localhost:5432/rifa

# `npx auth secret --raw`. En Vercel tiene que ser un valor distinto al de local.
AUTH_SECRET=

# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Quiénes reparten permisos. Separados por coma, sin espacios de más.
SUPER_ADMIN_EMAILS=tu.correo@gmail.com

# Solo en Vercel: la URL pública, para que el callback de Google vuelva bien.
# AUTH_URL=https://rifa-mzm.vercel.app
